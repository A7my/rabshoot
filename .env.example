# Copy to .env and fill in. Secrets live here, never in config.yaml.

# GitLab personal access token with `read_api` scope
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Slack USER token (xoxp-...) - required to read your DMs and group chats.
# Create a Slack app > OAuth & Permissions > User Token Scopes:
#   channels:history groups:history im:history mpim:history
#   channels:read    groups:read    im:read    mpim:read
#   users:read       chat:write
SLACK_USER_TOKEN=xoxp-xxxxxxxxxxxx

# Optional: if set, the report is posted by this bot instead of as you.
# Bot scopes: chat:write channels:read groups:read (and invite the bot to the target channel).
SLACK_BOT_TOKEN=

# AI provider key (Gemini: https://aistudio.google.com/apikey)
AI_API_KEY=

# Email account that SENDS the report.
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords),
#        not your normal password.
SMTP_USER=
SMTP_PASSWORD=
