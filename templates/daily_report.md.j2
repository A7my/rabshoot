{% else %}
{% for t in conv.threads[:max_items] %}
• {% if t.from_earlier %}_(thread from {{ t.date }})_ {% else %}`{{ t.time }}` {% endif %}*{{ t.user }}*: {{ t.text | oneline }}
{% for r in t.replies %}
      ↳ `{{ r.time }}` *{{ r.user }}*: {{ r.text | oneline }}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
